rules_version = '2';

// Studium's database. Members read it: accounts signed in with e-mail and password whose address belongs to an active
// community, as settings/app says, and admins (accounts with the custom claim admin: true, set with
// tools/set-admin.mjs). settings/app also says whether a confirmed address is required; the admins change it from the
// app's admin panel, and tools/deploy-rules.mjs creates it with the defaults of public/assets/config.js when missing.
//
// - catalog/{id} + guides/{id}: published study guides (the catalog entry, and the guide's HTML as gzip bytes).
// - contributions/{id}: compact, anonymous extracts of study material (concepts, question patterns, examples) that
//   together form the knowledge graph. Neither a contribution nor a guide names its author.
// - owners/{id}: the account that may replace or delete the guide or contribution with the same id; only that account
//   can read it. Guides published with the admin tool have no owner, so no browser can change them.
// - sources/{id}: the collections that material comes from, with their credits; published with the admin tools.
// - profiles/{uid}: the person's own settings, goals and progress; only that account reads or writes it.
// - kudos/{guide}__{uid}: the thanks an account gives a guide. Only fixed, positive kinds: nobody can write a comment.
// - tips/{professor}__{uid}: what an account knows about a professor, as fixed constructive tags; no free text.
// - library/{id}: shared course documents as links (Drive, OneDrive, Dropbox); the owner record works as for guides.
// - settings/app: the communities and their address domains, whether a confirmed address is required, and the page's
//   switches. Every signed-in account reads it; only admins write it. audit/{id}: what each admin changed.
// - presence/{uid}: when an account was last seen, written on real events (never on a timer); admins count them.
// - eggs/{id}: how many people found each easter egg, as a counter that only goes up by one.
// - stations/{id} (+ audio/{n}): the radio's stations as the admins set them; members read them.
// - sounds/{id} (+ audio/{n}): the audio the admins chose for a secret's sound; members read it.
// - packs/index + packs/{build}-{i}: every public contribution in a few documents, compiled by an admin on demand, so
//   a visit reads a handful of documents. removed/{id}: when a contribution stopped being public (deleted or made
//   private by its owner, or hidden by an admin), so every map drops it from its pack.
// A guide or contribution is public, or private to its owner. Lists return public documents only (a list query must
// ask for visibility == 'public'); the owner opens its private ones one by one.
service cloud.firestore {
  match /databases/{database}/documents {
    function at(collection, id) { return /databases/$(database)/documents/$(collection)/$(id); }
    function settings() { return get(at('settings', 'app')).data; }
    function admin() { return request.auth != null && request.auth.token.get('admin', false) == true; }
    // An account of an active community: its address domain is one the admins accepted, and the address is confirmed
    // when the settings require it. It signed in with its password, or with a token only the project's service account
    // can mint (the admin tools that act for an account, such as uploading material in its name).
    function student() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider in ['password', 'custom']
        && request.auth.token.get('email', '').lower().matches('[^@]+@[a-z0-9.-]+')
        && request.auth.token.email.lower().split('@')[1] in settings().domains
        && (settings().get('confirmEmail', false) != true || request.auth.token.email_verified == true);
    }
    function member() { return admin() || student(); }
    // The owner as stored before this request, and as it will be after it (a batch creates both together).
    function mine(id) { return get(at('owners', id)).data.uid == request.auth.uid; }
    function mineAfter(id) { return getAfter(at('owners', id)).data.uid == request.auth.uid; }
    // Ids created from the app are Firestore's random 20-character ids.
    function appId(id) { return id.matches('[A-Za-z0-9]{20}'); }
    function appIdOrSlug(id) { return id.matches('[A-Za-z0-9-]{3,100}'); }

    function shown(id) { return resource == null || resource.data.get('visibility', 'public') == 'public' || admin() || mine(id); }
    // An admin hiding or showing something: only its visibility (and its time) change.
    function hiding() {
      return admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visibility', 'updated'])
        && visibility(request.resource.data) && request.resource.data.updated == request.time;
    }
    function visibility(d) { return d.visibility in ['public', 'private']; }

    // History: before a person replaces or deletes a guide or a contribution of theirs, its current version is kept in
    // versions/{id}__{collection}__{millis of its last change}. The rules demand it, so nothing of anyone's part of the
    // graph is ever lost by a change; its owner and the admins can restore any version. Changing only who sees it
    // needs no copy (it is undone by changing it back).
    function stamp(d) { return 'updated' in d && d.updated is timestamp ? string(d.updated.toMillis()) : '0'; }
    function versionId(col, id) { return id + '__' + col + '__' + stamp(resource.data); }
    function kept(col, id) { return existsAfter(at('versions', versionId(col, id))); }
    function onlyWho() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visibility', 'updated']); }
    // An admin restores exactly one kept version of anyone's item: nothing else, and the current one is kept first.
    function restoring(col, id) {
      let v = getAfter(at('restores', id)).data.get(col, '');
      let old = get(at('versions', v)).data;
      return admin() && old.of == id && old.col == col && kept(col, id)
        && request.resource.data.diff(old.data).affectedKeys().hasOnly(['updated']) && request.resource.data.updated == request.time;
    }

    function text(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function optional(data, key, max) { return !(key in data) || (data[key] is string && data[key].size() <= max); }
    function described(d) {
      return text(d.course, 80) && text(d.title, 120) && text(d.theme, 24) && visibility(d)
        && optional(d, 'code', 30) && optional(d, 'university', 60) && optional(d, 'term', 60) && optional(d, 'professor', 80)
        && d.updated == request.time;
    }

    // The AI that made a guide, as its author states it.
    function made(a) {
      return a is map && a.keys().hasOnly(['provider', 'model', 'effort']) && a.provider in ['anthropic', 'openai', 'gemini', 'other']
        && (!('model' in a) || (a.model is string && a.model.size() <= 80))
        && (!('effort' in a) || a.effort in ['', 'low', 'medium', 'high', 'xhigh']);
    }
    function entry(d) {
      return d.keys().hasOnly(['course', 'code', 'university', 'term', 'professor', 'title', 'date', 'topics', 'concepts',
          'anchors', 'theme', 'level', 'visibility', 'by', 'ai', 'updated'])
        && optional(d, 'by', 60) && (!('ai' in d) || made(d.ai))
        && d.keys().hasAll(['course', 'title', 'date', 'topics', 'concepts', 'anchors', 'theme', 'visibility', 'updated'])
        && described(d)
        && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && (!('level' in d) || d.level in ['basic', 'standard', 'advanced'])
        && d.topics is list && d.topics.size() <= 40
        && d.concepts is list && d.concepts.size() <= 200
        && d.anchors is list && d.anchors.size() == d.concepts.size();
    }
    function guide(d) {
      return d.keys().hasOnly(['title', 'html', 'encoding', 'size', 'visibility', 'updated'])
        && d.keys().hasAll(['title', 'html', 'encoding', 'size', 'visibility', 'updated'])
        && text(d.title, 220) && visibility(d) && d.html is bytes && d.html.size() <= 900000 && d.encoding == 'gzip' && d.size is int
        && d.updated == request.time;
    }
    // stage: the evaluation it belongs to. source: a registered collection it comes from (it gets the credit). print: the
    // fingerprint of the original file, so the same file is not added twice.
    function contribution(d) {
      return d.keys().hasOnly(['kind', 'course', 'code', 'university', 'term', 'professor', 'title', 'stage', 'theme', 'source',
          'print', 'concepts', 'questions', 'examples', 'body', 'encoding', 'visibility', 'updated'])
        && d.keys().hasAll(['kind', 'course', 'title', 'theme', 'concepts', 'questions', 'examples', 'body', 'encoding',
          'visibility', 'updated'])
        && d.kind in ['exam', 'homework', 'lab', 'slides', 'notes', 'summary', 'book', 'syllabus', 'contest', 'curriculum', 'other']
        && described(d)
        && optional(d, 'stage', 40)
        && (!('source' in d) || (d.source is string && d.source.matches('[a-z0-9][a-z0-9-]{2,60}') && exists(at('sources', d.source))))
        && (!('print' in d) || (d.print is string && d.print.matches('[0-9a-f]{16,40}')))
        && d.concepts is list && d.concepts.size() <= 300
        && d.questions is int && d.examples is int
        && d.body is bytes && d.body.size() <= 900000 && d.encoding == 'gzip';
    }

    // A guide's catalog entry and its HTML always share the same visibility.
    function sameAs(collection, id) { return getAfter(at(collection, id)).data.visibility == request.resource.data.visibility; }

    match /catalog/{id} {
      allow get: if member() && shown(id);
      allow list: if member() && (resource.data.visibility == 'public' || admin());
      allow create: if student() && appId(id) && entry(request.resource.data) && mineAfter(id) && sameAs('guides', id);
      allow update: if (student() && mine(id) && entry(request.resource.data) && sameAs('guides', id) && (onlyWho() || kept('catalog', id)))
        || (hiding() && sameAs('guides', id)) || (restoring('catalog', id) && sameAs('guides', id));
      allow delete: if ((student() && mine(id) && kept('catalog', id)) || admin()) && !existsAfter(at('guides', id));
    }

    // One guide at a time: listing every guide would download all of them.
    match /guides/{id} {
      allow get: if member() && shown(id);
      allow create: if student() && appId(id) && guide(request.resource.data) && mineAfter(id) && sameAs('catalog', id);
      allow update: if (student() && mine(id) && guide(request.resource.data) && sameAs('catalog', id) && (onlyWho() || kept('guides', id)))
        || (hiding() && sameAs('catalog', id)) || (restoring('guides', id) && sameAs('catalog', id));
      allow delete: if ((student() && mine(id) && kept('guides', id)) || admin()) && !existsAfter(at('catalog', id));
    }

    match /contributions/{id} {
      allow get: if member() && shown(id);
      allow list: if member() && (resource.data.visibility == 'public' || admin());
      allow create: if student() && appId(id) && contribution(request.resource.data) && mineAfter(id);
      allow update: if (student() && mine(id) && contribution(request.resource.data) && (onlyWho() || kept('contributions', id)))
        || hiding() || restoring('contributions', id);
      allow delete: if (student() && mine(id) && kept('contributions', id)) || admin();
    }

    // An owner is recorded only together with the guide or contribution it creates, which must not exist yet.
    match /sources/{id} {
      allow read: if member();
    }

    // The person's own space.
    function profile(d) {
      return d.keys().hasOnly(['nickname', 'name', 'career', 'semester', 'mode', 'ambience', 'sound', 'theme', 'lang', 'avatar',
          'goals', 'progress', 'deadlines', 'todos', 'plan', 'tiles', 'notes', 'links', 'focus', 'bubbles', 'courses', 'interests', 'known', 'malla', 'passed', 'updated'])
        && optional(d, 'nickname', 40) && optional(d, 'name', 60) && optional(d, 'career', 80)
        && (!('lang' in d) || d.lang in ['es', 'en'])
        && (!('avatar' in d) || d.avatar in ['blue', 'red', 'teal', 'butter', 'sky', 'peach'])
        && (!('semester' in d) || (d.semester is int && d.semester >= 0 && d.semester <= 20))
        && (!('mode' in d) || d.mode in ['examenes', 'gusto', 'intensivo', 'metas'])
        && (!('ambience' in d) || d.ambience in ['jugueton', 'vivo', 'sereno', 'enfoque'])
        && (!('sound' in d) || d.sound is bool)
        && (!('bubbles' in d) || d.bubbles is bool)
        && (!('theme' in d) || d.theme in ['auto', 'light', 'dark'])
        && (!('goals' in d) || (d.goals is list && d.goals.size() <= 60))
        && (!('progress' in d) || (d.progress is map && d.progress.size() <= 300))
        // The home page: the person's own dates, which tiles it shows, a notepad, quick links and the focus timer.
        && (!('deadlines' in d) || (d.deadlines is list && d.deadlines.size() <= 60))
        && (!('todos' in d) || (d.todos is list && d.todos.size() <= 80))
        && (!('plan' in d) || (d.plan is list && d.plan.size() <= 12))
        && (!('tiles' in d) || (d.tiles is list && d.tiles.size() <= 16))
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 4000))
        && (!('links' in d) || (d.links is list && d.links.size() <= 12))
        && (!('focus' in d) || (d.focus is map && d.focus.keys().hasOnly(['study', 'rest'])
          && d.focus.study is int && d.focus.study >= 5 && d.focus.study <= 90
          && d.focus.rest is int && d.focus.rest >= 1 && d.focus.rest <= 30))
        // The map: the person's courses this term, their interests, and the concepts they marked as known.
        && (!('courses' in d) || (d.courses is list && d.courses.size() <= 40))
        && (!('interests' in d) || (d.interests is list && d.interests.size() <= 40))
        && (!('known' in d) || (d.known is list && d.known.size() <= 1500))
        // «Mi malla»: the career's code and the classes marked as passed.
        && (!('malla' in d) || (d.malla is string && d.malla.matches('[0-9A-Z]{0,8}')))
        && (!('passed' in d) || (d.passed is list && d.passed.size() <= 150))
        && d.updated == request.time;
    }
    match /profiles/{uid} {
      allow get, delete: if member() && request.auth.uid == uid;
      allow create, update: if member() && request.auth.uid == uid && profile(request.resource.data);
    }

    // The person's schedule: «mine», the semester's definitive week, and up to six drafts to prepare enrollment, read
    // and written only by its owner. «share» stays empty until friends exist (0.6.0); the classes inside are checked
    // by the app, and the document's size by Firestore.
    function schedule(d) {
      return d.keys().hasOnly(['mine', 'options', 'active', 'term', 'share', 'updated']) && d.keys().hasAll(['options', 'active', 'updated'])
        && (!('mine' in d) || (d.mine is map && d.mine.keys().hasOnly(['id', 'name', 'classes']) && d.mine.classes is list && d.mine.classes.size() <= 40))
        && (!('term' in d) || (d.term is string && d.term.matches('([0-9]{6})?')))
        && d.options is list && d.options.size() >= 1 && d.options.size() <= 6
        && d.active is int && d.active >= 0 && d.active < d.options.size()
        && (!('share' in d) || (d.share is list && d.share.size() == 0))
        && d.updated == request.time;
    }
    match /schedules/{uid} {
      allow get, delete: if member() && request.auth.uid == uid;
      allow create, update: if member() && request.auth.uid == uid && schedule(request.resource.data);
    }

    // The drafts of «Crea tu guía»: the fields the person filled in (never the notes or the material), read and
    // written only by its owner, so a draft is not lost on another device.
    function drafts(d) {
      return d.keys().hasOnly(['material', 'guide', 'updated']) && d.keys().hasAll(['updated'])
        && (!('material' in d) || (d.material is map && d.material.size() <= 30))
        && (!('guide' in d) || (d.guide is map && d.guide.size() <= 30))
        && d.updated == request.time;
    }
    match /drafts/{uid} {
      allow get, delete: if member() && request.auth.uid == uid;
      allow create, update: if member() && request.auth.uid == uid && drafts(request.resource.data);
    }

    // Feedback: a member writes; only its sender and the admins read it; only the admins answer. A few per day per
    // account: each one counts in feedbackDay/{uid} in the same write, and the count of a day stops at 10.
    function today() { return math.floor(request.time.toMillis() / 86400000); }
    function dayCount(uid) {
      return getAfter(at('feedbackDay', uid)).data.day == today()
        && getAfter(at('feedbackDay', uid)).data.n == (exists(at('feedbackDay', uid)) && get(at('feedbackDay', uid)).data.day == today() ? get(at('feedbackDay', uid)).data.n + 1 : 1);
    }
    function feedback(d) {
      return d.keys().hasOnly(['uid', 'from', 'kind', 'text', 'page', 'version', 'agent', 'log', 'errors', 'shot', 'created', 'status'])
        && d.keys().hasAll(['uid', 'kind', 'text', 'page', 'created', 'status'])
        && d.uid == request.auth.uid && d.created == request.time && d.status == 'nuevo'
        && d.kind in ['error', 'ia', 'urgente', 'sugerencia', 'funcion', 'gracias', 'comentario']
        && text(d.text, 5000) && optional(d, 'from', 120) && optional(d, 'page', 300) && optional(d, 'version', 40) && optional(d, 'agent', 300)
        && optional(d, 'log', 150000) && optional(d, 'errors', 30000)
        && (!('shot' in d) || (d.shot is string && d.shot.size() <= 450000 && d.shot.matches('data:image/(jpeg|webp|png);base64,[A-Za-z0-9+/=]+')));
    }
    match /feedback/{id} {
      allow create: if member() && feedback(request.resource.data) && dayCount(request.auth.uid);
      allow get, list: if admin() || (member() && resource.data.uid == request.auth.uid);
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answer', 'answered'])
        && request.resource.data.status in ['nuevo', 'visto', 'resuelto', 'descartado']
        && optional(request.resource.data, 'answer', 5000)
        && (!('answered' in request.resource.data) || request.resource.data.answered == request.time);
      allow delete: if admin() || (member() && resource.data.uid == request.auth.uid);
    }
    match /feedbackDay/{uid} {
      allow get: if member() && request.auth.uid == uid;
      allow create, update: if member() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['day', 'n']) && request.resource.data.day == today()
        && request.resource.data.n is int && request.resource.data.n <= 10
        && request.resource.data.n == (resource != null && resource.data.day == today() ? resource.data.n + 1 : 1);
    }

    // A list without repeated values, all of them from the allowed ones.
    function picked(value, allowed, max) {
      return value is list && value.size() > 0 && value.size() <= max && value.toSet().size() == value.size() && value.hasOnly(allowed);
    }

    function kudo(id, d) {
      return d.keys().hasOnly(['guide', 'kinds', 'updated']) && d.keys().hasAll(['guide', 'kinds', 'updated'])
        && d.guide is string && d.guide.matches('[A-Za-z0-9-]{3,100}') && id == d.guide + '__' + request.auth.uid
        && exists(at('catalog', d.guide))
        && picked(d.kinds, ['salvo', 'entendi', 'examen', 'gracias'], 4)
        && d.updated == request.time;
    }
    match /kudos/{id} {
      allow read: if member();
      allow create, update: if student() && kudo(id, request.resource.data);
      allow delete: if (student() && id == resource.data.guide + '__' + request.auth.uid) || admin();
    }

    // A professor's name or a course: text without digits, addresses or markup.
    function name(value, max) { return text(value, max) && value.size() >= 3 && !value.matches('.*[0-9@/<>{}].*'); }
    function tip(id, d) {
      return d.keys().hasOnly(['prof', 'professor', 'course', 'tags', 'updated']) && d.keys().hasAll(['prof', 'professor', 'tags', 'updated'])
        && d.prof is string && d.prof.matches('[a-z0-9-]{2,90}') && id == d.prof + '__' + request.auth.uid
        && name(d.professor, 80) && (!('course' in d) || name(d.course, 80))
        && picked(d.tags, ['explica-claro', 'ejemplos', 'practico', 'teorico', 'responde', 'tutorias',
          'examen-deberes', 'examen-clase', 'examenes-largos', 'procedimiento', 'formato', 'participacion', 'proyectos',
          'puntos-extra', 'recuperar', 'reclamos', 'material',
          'asistencia', 'puntual', 'sin-formulas', 'leer-antes', 'ritmo', 'exigente',
          'ideal-teoria', 'ideal-practica', 'ideal-autonomo', 'ideal-guiado'], 27)
        && d.updated == request.time;
    }
    match /tips/{id} {
      allow read: if member();
      allow create, update: if student() && tip(id, request.resource.data);
      allow delete: if (student() && id == resource.data.prof + '__' + request.auth.uid) || admin();
    }

    // The library: course documents anyone may share (syllabi, lab guides, assignments, the professor's own material),
    // as links to where they are shared. Studium stores no file.
    function shared(id, d) {
      return d.keys().hasOnly(['course', 'code', 'professor', 'term', 'kind', 'title', 'url', 'note', 'by', 'updated'])
        && d.keys().hasAll(['course', 'kind', 'title', 'url', 'updated'])
        && name(d.course, 80) && text(d.title, 140) && optional(d, 'code', 30) && optional(d, 'term', 60)
        && optional(d, 'note', 200) && optional(d, 'by', 60) && (!('professor' in d) || name(d.professor, 80))
        && d.kind in ['syllabus', 'reading', 'lab', 'assignment', 'slides', 'other']
        && d.url is string && d.url.size() <= 500
        && d.url.matches('https://(drive[.]google[.]com|docs[.]google[.]com|onedrive[.]live[.]com|1drv[.]ms|[a-z0-9-]+[.]sharepoint[.]com|(www[.])?dropbox[.]com)/[^ <>"]*')
        && d.updated == request.time;
    }
    match /library/{id} {
      allow read: if member();
      allow create: if student() && appId(id) && shared(id, request.resource.data) && mineAfter(id);
      allow update: if student() && mine(id) && shared(id, request.resource.data);
      allow delete: if (student() && mine(id)) || admin();
    }

    // A kept version: an exact copy of the item as it is now, made by its owner (or an admin), read only by them.
    function version(vid, d) {
      return d.keys().hasOnly(['of', 'col', 'uid', 'action', 'at', 'data']) && d.keys().hasAll(['of', 'col', 'uid', 'action', 'at', 'data'])
        && d.col in ['contributions', 'guides', 'catalog'] && d.of is string && appIdOrSlug(d.of)
        && vid == d.of + '__' + d.col + '__' + stamp(get(at(d.col, d.of)).data)
        && d.data == get(at(d.col, d.of)).data && d.uid == get(at('owners', d.of)).data.uid
        && (mine(d.of) || admin()) && d.action in ['replaced', 'deleted', 'restored'] && d.at == request.time;
    }
    match /versions/{vid} {
      allow create, update: if member() && version(vid, request.resource.data);
      allow get, list: if admin() || (member() && resource.data.uid == request.auth.uid);
      allow delete: if admin() || (member() && resource.data.uid == request.auth.uid);
    }
    // What an admin restores: for each part of the item, the kept version it returns to.
    function restoreOf(d, col, id) { return !(col in d) || (d[col] is string && get(at('versions', d[col])).data.of == id); }
    match /restores/{id} {
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['contributions', 'guides', 'catalog'])
        && request.resource.data.size() > 0 && restoreOf(request.resource.data, 'contributions', id)
        && restoreOf(request.resource.data, 'guides', id) && restoreOf(request.resource.data, 'catalog', id);
    }

    match /owners/{id} {
      allow read: if member() && resource.data.uid == request.auth.uid;
      allow create: if student() && appId(id)
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
        && ((existsAfter(at('guides', id)) && !exists(at('guides', id)))
          || (existsAfter(at('contributions', id)) && !exists(at('contributions', id)))
          || (existsAfter(at('library', id)) && !exists(at('library', id))));
      allow delete: if ((student() && resource.data.uid == request.auth.uid) || admin())
        && !existsAfter(at('guides', id)) && !existsAfter(at('contributions', id)) && !existsAfter(at('library', id));
    }

    // The app's settings, kept by the admins.
    function community(c) {
      return c is map && c.keys().hasOnly(['id', 'name', 'full', 'domains', 'active']) && c.keys().hasAll(['id', 'name', 'domains', 'active'])
        && c.id is string && c.id.matches('[a-z0-9-]{2,30}') && text(c.name, 40) && optional(c, 'full', 120)
        && c.domains is list && c.domains.size() <= 20 && c.active is bool;
    }
    function appSettings(d) {
      return d.keys().hasOnly(['communities', 'domains', 'confirmEmail', 'flags', 'providers', 'announcement', 'googleClientId', 'updated', 'by'])
        && d.keys().hasAll(['communities', 'domains', 'confirmEmail', 'updated', 'by'])
        && d.communities is list && d.communities.size() >= 1 && d.communities.size() <= 30
        && community(d.communities[0])
        && d.domains is list && d.domains.size() <= 100
        && d.confirmEmail is bool
        && (!('flags' in d) || (d.flags is map && d.flags.size() <= 30))
        && (!('providers' in d) || (d.providers is list && d.providers.hasOnly(['anthropic', 'openai', 'gemini'])))
        && (!('announcement' in d) || (d.announcement is map && d.announcement.keys().hasOnly(['on', 'text', 'level'])
          && d.announcement.on is bool && d.announcement.text is string && d.announcement.text.size() <= 280
          && d.announcement.level in ['info', 'good', 'warn']))
        && (!('googleClientId' in d) || (d.googleClientId is string && d.googleClientId.size() <= 120))
        && d.by == request.auth.token.email && d.updated == request.time;
    }
    match /settings/{id} {
      allow get: if request.auth != null;
      allow create, update: if admin() && id == 'app' && appSettings(request.resource.data);
    }
    match /audit/{id} {
      allow read: if admin();
      allow create: if admin() && request.resource.data.keys().hasOnly(['action', 'detail', 'by', 'at'])
        && text(request.resource.data.action, 60) && request.resource.data.detail is string && request.resource.data.detail.size() <= 2000
        && request.resource.data.by == request.auth.token.email && request.resource.data.at == request.time;
    }

    // When an account was last seen: written on real events (signing in, opening the page, coming back to it,
    // changing page), never on a timer. Admins count them; nobody sees another account's document.
    match /presence/{uid} {
      allow get: if member() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create, update: if member() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at', 'community', 'since'])
        && request.resource.data.at == request.time
        && request.resource.data.community is string && request.resource.data.community.size() <= 30
        && request.resource.data.since is timestamp;
    }

    // Packs: compiled by admins; every member reads them.
    function packIndex(d) {
      return d.keys().hasOnly(['build', 'parts', 'count', 'at', 'built', 'by']) && d.keys().hasAll(['build', 'parts', 'count', 'at', 'built', 'by'])
        && d.build is string && d.build.matches('[a-z0-9]{4,30}') && d.parts is int && d.parts >= 0 && d.parts <= 400
        && d.count is int && d.at is timestamp && d.built == request.time && d.by == request.auth.token.email;
    }
    function packPart(id, d) {
      return d.keys().hasOnly(['build', 'i', 'of', 'data']) && d.keys().hasAll(['build', 'i', 'of', 'data'])
        && d.build is string && d.i is int && d.of is int && id == d.build + '-' + string(d.i)
        && d.data is bytes && d.data.size() <= 900000;
    }
    match /packs/{id} {
      allow read: if member();
      allow create, update: if admin() && ((id == 'index' && packIndex(request.resource.data)) || (id != 'index' && packPart(id, request.resource.data)));
      allow delete: if admin() && id != 'index';
    }
    // A contribution that stopped being public: written by its owner in the same batch that deletes it or makes it
    // private (or by an admin), and read by every map.
    match /removed/{id} {
      allow read: if member();
      allow create, update: if (admin() || (student() && mine(id)))
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
    }

    // The person's AI keys, encrypted on their device with a key derived from their password (vault.js): only its owner
    // reads or writes it, not even the admins; and what is kept is ciphertext.
    match /vaults/{uid} {
      allow get, delete: if member() && request.auth.uid == uid;
      allow create, update: if member() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['salt', 'iter', 'iv', 'data', 'updated'])
        && request.resource.data.keys().hasAll(['salt', 'iter', 'iv', 'data', 'updated'])
        && text(request.resource.data.salt, 64) && request.resource.data.iter is int
        && request.resource.data.iter >= 100000 && request.resource.data.iter <= 10000000
        && text(request.resource.data.iv, 32) && text(request.resource.data.data, 40000)
        && request.resource.data.updated == request.time;
    }

    // «Yo quiero» in Comunidad: how many people wait for each coming idea. A person counts once: their mark
    // wanted/{idea}__{uid} and the counter change together, up by one with the mark, down by one without it.
    function ideas() { return ['amigos', 'grupos', 'horario', 'musica', 'postits', 'juego', 'logros', 'campus']; }
    function mark(idea) { return at('wanted', idea + '__' + request.auth.uid); }
    match /wants/{idea} {
      allow read: if member();
      allow create: if member() && idea in ideas() && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1
        && !exists(mark(idea)) && existsAfter(mark(idea));
      allow update: if member() && request.resource.data.keys().hasOnly(['count'])
        && ((request.resource.data.count == resource.data.count + 1 && !exists(mark(idea)) && existsAfter(mark(idea)))
          || (request.resource.data.count == resource.data.count - 1 && exists(mark(idea)) && !existsAfter(mark(idea))));
    }
    match /wanted/{id} {
      allow get: if member() && id.matches('.*__' + request.auth.uid);
      allow create: if member() && request.resource.data.keys().hasOnly(['idea']) && request.resource.data.idea in ideas()
        && id == request.resource.data.idea + '__' + request.auth.uid
        && getAfter(at('wants', request.resource.data.idea)).data.count == (exists(at('wants', request.resource.data.idea)) ? get(at('wants', request.resource.data.idea)).data.count + 1 : 1);
      allow delete: if member() && id == resource.data.idea + '__' + request.auth.uid
        && getAfter(at('wants', resource.data.idea)).data.count == get(at('wants', resource.data.idea)).data.count - 1;
    }

    // How many people found each easter egg: a counter that only goes up by one.
    match /eggs/{id} {
      allow read: if admin();
      allow create: if member() && id in ['radio', 'portal', 'cake', 'medic', 'crit', 'cafe', 'starve']
        && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1;
      allow update: if member() && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == resource.data.count + 1;
    }

    // «Trabajos»: an assignment, its solution guide and its group. Only its members read anything of it. A person
    // joins with the code of the invitation link (proved here against the trabajo's code, which they cannot read
    // before joining); only its creator changes the trabajo itself or removes someone. Each member writes only their
    // own progress and their own log of AI use; any member may write a milestone of the guide.
    function trabajoAt(tid) { return /databases/$(database)/documents/trabajos/$(tid); }
    function inTrabajo(tid) { return exists(/databases/$(database)/documents/trabajos/$(tid)/miembros/$(request.auth.uid)); }
    function ownsTrabajo(tid) { return get(trabajoAt(tid)).data.owner == request.auth.uid; }
    function trabajo(d) {
      return d.keys().hasOnly(['title', 'course', 'group', 'deadline', 'prefs', 'parts', 'owner', 'code', 'statement', 'outline', 'encoding', 'ai', 'repo', 'created', 'updated'])
        && d.keys().hasAll(['title', 'parts', 'owner', 'code', 'statement', 'encoding', 'created', 'updated'])
        && text(d.title, 160) && optional(d, 'course', 120) && optional(d, 'group', 80) && optional(d, 'deadline', 40)
        && d.parts is int && d.parts >= 1 && d.parts <= 8
        && d.code is string && d.code.matches('[A-Za-z0-9_-]{24,64}')
        && d.statement is bytes && d.statement.size() <= 600000 && d.encoding == 'gzip'
        && (!('outline' in d) || (d.outline is bytes && d.outline.size() <= 600000))
        && (!('ai' in d) || made(d.ai))
        && (!('prefs' in d) || (d.prefs is map && d.prefs.size() <= 30 && (!('note' in d.prefs) || (d.prefs.note is string && d.prefs.note.size() <= 1500))))
        && (!('repo' in d) || (d.repo is map && d.repo.keys().hasOnly(['owner', 'name']) && text(d.repo.owner, 100) && text(d.repo.name, 100)))
        && d.created is timestamp && d.updated == request.time;
    }
    match /trabajos/{tid} {
      allow get: if member() && inTrabajo(tid);
      allow create: if member() && appId(tid) && trabajo(request.resource.data) && request.resource.data.owner == request.auth.uid
        && request.resource.data.created == request.time
        && existsAfter(/databases/$(database)/documents/trabajos/$(tid)/miembros/$(request.auth.uid));
      allow update: if member() && resource.data.owner == request.auth.uid && trabajo(request.resource.data)
        && request.resource.data.owner == resource.data.owner && request.resource.data.created == resource.data.created;
      allow delete: if member() && resource.data.owner == request.auth.uid;

      match /miembros/{uid} {
        allow get, list: if member() && inTrabajo(tid);
        allow create: if member() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'code', 'joined']) && text(request.resource.data.name, 40)
          && request.resource.data.joined == request.time && request.resource.data.code == getAfter(trabajoAt(tid)).data.code;
        allow update: if member() && uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && text(request.resource.data.name, 40);
        allow delete: if member() && (uid == request.auth.uid || ownsTrabajo(tid));
      }
      match /partes/{letter} {
        allow get, list: if member() && inTrabajo(tid);
        allow create: if member() && inTrabajo(tid)
          && letter in ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H']
          && {'A': 1, 'B': 2, 'C': 3, 'D': 4, 'E': 5, 'F': 6, 'G': 7, 'H': 8}[letter] <= get(trabajoAt(tid)).data.parts
          && request.resource.data.keys().hasOnly(['uid', 'at']) && request.resource.data.uid == request.auth.uid
          && request.resource.data.at == request.time;
        allow delete: if member() && inTrabajo(tid) && (resource.data.uid == request.auth.uid || ownsTrabajo(tid));
      }
      match /hitos/{hid} {
        allow get, list: if member() && inTrabajo(tid);
        allow create, update: if member() && inTrabajo(tid) && hid.matches('[A-Z]{1,2}[0-9]{1,3}')
          && request.resource.data.keys().hasOnly(['data', 'encoding', 'by', 'ai', 'updated'])
          && request.resource.data.data is bytes && request.resource.data.data.size() <= 900000 && request.resource.data.encoding == 'gzip'
          && request.resource.data.by == request.auth.uid && (!('ai' in request.resource.data) || made(request.resource.data.ai))
          && request.resource.data.updated == request.time;
        allow delete: if member() && ownsTrabajo(tid);
      }
      match /avance/{uid} {
        allow get, list: if member() && inTrabajo(tid);
        allow create, update: if member() && inTrabajo(tid) && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['steps', 'updated']) && request.resource.data.steps is map
          && request.resource.data.steps.size() <= 600 && request.resource.data.updated == request.time;
        allow delete: if member() && (uid == request.auth.uid || ownsTrabajo(tid));
      }
      // «¿Cuándo nos reunimos?» (reunion.js): each member's free half hours per week, written only by them; proposals
      // anyone makes, where each member adds or removes only their own yes or no.
      match /disponible/{uid} {
        allow get, list: if member() && inTrabajo(tid);
        allow create, update: if member() && inTrabajo(tid) && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['weeks', 'share', 'busy', 'updated']) && request.resource.data.weeks is map
          && request.resource.data.weeks.size() <= 8 && request.resource.data.updated == request.time
          && (!('share' in request.resource.data) || request.resource.data.share in ['none', 'busy', 'detail'])
          && (!('busy' in request.resource.data) || (request.resource.data.busy is list && request.resource.data.busy.size() <= 80
            && (request.resource.data.busy.size() == 0 || request.resource.data.get('share', 'none') != 'none')));
        allow delete: if member() && (uid == request.auth.uid || ownsTrabajo(tid));
      }
      match /reunion/{pid} {
        allow get, list: if member() && inTrabajo(tid);
        allow create: if member() && inTrabajo(tid)
          && request.resource.data.keys().hasOnly(['week', 'slot', 'len', 'by', 'si', 'no', 'updated'])
          && request.resource.data.week is string && request.resource.data.week.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.slot is int && request.resource.data.slot >= 0 && request.resource.data.slot < 210
          && request.resource.data.len is int && request.resource.data.len >= 1 && request.resource.data.len <= 8
          && request.resource.data.by == request.auth.uid && request.resource.data.si == [request.auth.uid]
          && request.resource.data.no == [] && request.resource.data.updated == request.time;
        allow update: if member() && inTrabajo(tid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['si', 'no', 'updated'])
          && request.resource.data.si is list && request.resource.data.no is list
          && request.resource.data.si.size() <= 8 && request.resource.data.no.size() <= 8
          && request.resource.data.si.toSet().difference(resource.data.si.toSet()).hasOnly([request.auth.uid])
          && resource.data.si.toSet().difference(request.resource.data.si.toSet()).hasOnly([request.auth.uid])
          && request.resource.data.no.toSet().difference(resource.data.no.toSet()).hasOnly([request.auth.uid])
          && resource.data.no.toSet().difference(request.resource.data.no.toSet()).hasOnly([request.auth.uid])
          && request.resource.data.updated == request.time;
        allow delete: if member() && (resource.data.by == request.auth.uid || ownsTrabajo(tid));
      }
      match /ia/{uid} {
        allow get, list: if member() && inTrabajo(tid);
        allow create, update: if member() && inTrabajo(tid) && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['log', 'updated']) && request.resource.data.log is list
          && request.resource.data.log.size() <= 300 && request.resource.data.updated == request.time;
        allow delete: if member() && (uid == request.auth.uid || ownsTrabajo(tid));
      }
    }
    // Which trabajos a person belongs to, kept by that person only (so their list opens without searching).
    match /misTrabajos/{uid} {
      allow get, delete: if member() && uid == request.auth.uid;
      allow create, update: if member() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ids', 'updated']) && request.resource.data.ids is list
        && request.resource.data.ids.size() <= 60 && request.resource.data.updated == request.time;
    }

    // «Amigos» (docs/v0.6.0.md §4): a friend is added with a link or a code. The link is its owner's proposal; whoever
    // opens it and accepts writes the friendship on both sides at once, proving it with the code. Either side ends it
    // alone, on both sides. A new code voids the old one.
    // amigoCodes/{code}: whose code it is and the name their friends see; any member who knows the code reads it.
    // amigos/{uid}: the person's current code. amigos/{uid}/lista/{other}: a friend. amigos/{uid}/invitaciones/{tid}:
    // a trabajo a friend invited them to, carrying its code (they join with it as with the link).
    function codeOf(code) { return get(at('amigoCodes', code)).data; }
    function friends(a, b) {
      return exists(/databases/$(database)/documents/amigos/$(a)/lista/$(b)) && exists(/databases/$(database)/documents/amigos/$(b)/lista/$(a));
    }
    match /amigoCodes/{code} {
      allow get: if member();
      allow create: if member() && code.matches('[A-Za-z0-9_-]{24,64}')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'updated']) && request.resource.data.uid == request.auth.uid
        && text(request.resource.data.name, 40) && request.resource.data.updated == request.time
        && getAfter(at('amigos', request.auth.uid)).data.code == code;
      allow update: if member() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updated'])
        && text(request.resource.data.name, 40) && request.resource.data.updated == request.time;
      allow delete: if member() && resource.data.uid == request.auth.uid;
    }
    match /amigos/{uid} {
      allow get, delete: if member() && uid == request.auth.uid;
      allow create, update: if member() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['code', 'updated']) && request.resource.data.code is string
        && request.resource.data.code.matches('[A-Za-z0-9_-]{24,64}') && request.resource.data.updated == request.time;

      match /lista/{other} {
        allow get, list: if member() && uid == request.auth.uid;
        // Written by either of the two, with the code of the other one: the writer accepts the other's proposal.
        allow create: if member() && uid != other && request.auth.uid in [uid, other]
          && request.resource.data.keys().hasOnly(['name', 'code', 'since']) && text(request.resource.data.name, 40)
          && request.resource.data.since == request.time && request.resource.data.code is string
          && codeOf(request.resource.data.code).uid == (request.auth.uid == uid ? other : uid);
        allow delete: if member() && request.auth.uid in [uid, other];
      }
      match /invitaciones/{tid} {
        allow get, list: if member() && uid == request.auth.uid;
        allow create: if member() && request.resource.data.keys().hasOnly(['title', 'from', 'name', 'code', 'at'])
          && request.resource.data.from == request.auth.uid && uid != request.auth.uid
          && text(request.resource.data.title, 160) && text(request.resource.data.name, 40) && request.resource.data.at == request.time
          && friends(uid, request.auth.uid) && inTrabajo(tid) && request.resource.data.code == get(trabajoAt(tid)).data.code;
        allow delete: if member() && (uid == request.auth.uid || resource.data.from == request.auth.uid);
      }
    }

    // stations/{id}: the radio's stations, as the admins set them in the panel: a tune generated live, a YouTube
    // upload (with or without its caption), or an audio file kept in pieces (stations/{id}/audio/{n}, under 1 MB each)
    // that plays in a seamless loop. Members read them; only admins write them.
    function station(d) {
      return d.keys().hasOnly(['name', 'freq10', 'opens', 'kind', 'gen', 'video', 'caption', 'showCaption', 'audio', 'on', 'updated'])
        && text(d.name, 80) && d.freq10 is int && d.freq10 >= 880 && d.freq10 <= 1080
        && d.opens in ['radio', 'portal', 'cake', 'medic', 'crit', 'cafe', 'starve', 'all']
        && d.kind in ['gen', 'youtube', 'audio'] && d.on is bool
        && (!('gen' in d) || (d.gen is string && d.gen.size() <= 20))
        && (!('video' in d) || (d.video is string && d.video.matches('^[A-Za-z0-9_-]{6,20}$')))
        && (!('caption' in d) || (d.caption is string && d.caption.size() <= 400))
        && (!('showCaption' in d) || d.showCaption is bool)
        && (!('audio' in d) || (d.audio is map && d.audio.keys().hasOnly(['pieces', 'type', 'size', 'name'])
          && d.audio.pieces is int && d.audio.pieces >= 1 && d.audio.pieces <= 12 && d.audio.type is string && d.audio.type.size() <= 40
          && d.audio['size'] is int && d.audio['size'] <= 12000000 && d.audio['name'] is string && d.audio['name'].size() <= 120))
        && d.updated == request.time;
    }
    // sounds/{id}: the audio the admins chose for a secret's sound (the shout of «¡Médico!»), in pieces like a station's.
    match /sounds/{id} {
      allow read: if member();
      allow create, update: if admin() && id in ['medic'] && request.resource.data.keys().hasOnly(['name', 'type', 'size', 'pieces', 'updated'])
        && request.resource.data['name'] is string && request.resource.data['name'].size() <= 120 && request.resource.data.type is string && request.resource.data.type.size() <= 40
        && request.resource.data['size'] is int && request.resource.data['size'] <= 3000000 && request.resource.data.pieces is int && request.resource.data.pieces >= 1 && request.resource.data.pieces <= 4
        && request.resource.data.updated == request.time;
      allow delete: if admin();
      match /audio/{n} {
        allow read: if member();
        allow create, update: if admin() && n.matches('^[0-9]$') && request.resource.data.keys().hasOnly(['b', 'i'])
          && request.resource.data.b is bytes && request.resource.data.b.size() <= 1000000 && request.resource.data.i is int;
        allow delete: if admin();
      }
    }
    match /stations/{id} {
      allow read: if member();
      allow create, update: if admin() && id.matches('^[a-z0-9-]{1,30}$') && station(request.resource.data);
      allow delete: if admin();
      match /audio/{n} {
        allow read: if member();
        allow create, update: if admin() && n.matches('^[0-9]{1,2}$') && request.resource.data.keys().hasOnly(['b', 'i'])
          && request.resource.data.b is bytes && request.resource.data.b.size() <= 1000000 && request.resource.data.i is int;
        allow delete: if admin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
