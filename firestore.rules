rules_version = '2';

// Studium's database. Members read it: accounts signed in with e-mail and password whose address belongs to an active
// community, as settings/app says, and admins (accounts with the custom claim admin: true, set with
// tools/set-admin.mjs). settings/app also says whether a confirmed address is required; the admins change it from the
// app's admin panel, and tools/deploy-rules.mjs creates it with the defaults of public/assets/config.js when missing.
//
// - catalog/{id} + guides/{id}: published study guides (the catalog entry, and the guide's HTML as gzip bytes).
// - contributions/{id}: compact, anonymous extracts of study material (concepts, question patterns, examples) that
//   together form the knowledge graph. Neither a contribution nor a guide names its author.
// - owners/{id}: the account that may replace or delete the guide or contribution with the same id; only that account
//   can read it. Guides published with the admin tool have no owner, so no browser can change them.
// - sources/{id}: the collections that material comes from, with their credits; published with the admin tools.
// - profiles/{uid}: the person's own settings, goals and progress; only that account reads or writes it.
// - kudos/{guide}__{uid}: the thanks an account gives a guide. Only fixed, positive kinds: nobody can write a comment.
// - tips/{professor}__{uid}: what an account knows about a professor, as fixed constructive tags; no free text.
// - library/{id}: shared course documents as links (Drive, OneDrive, Dropbox); the owner record works as for guides.
// - settings/app: the communities and their address domains, whether a confirmed address is required, and the page's
//   switches. Every signed-in account reads it; only admins write it. audit/{id}: what each admin changed.
// - presence/{uid}: when an account was last seen, written on real events (never on a timer); admins count them.
// - eggs/{id}: how many people found each easter egg, as a counter that only goes up by one.
// - packs/index + packs/{build}-{i}: every public contribution in a few documents, compiled by an admin on demand, so
//   a visit reads a handful of documents. removed/{id}: when a contribution stopped being public (deleted or made
//   private by its owner, or hidden by an admin), so every map drops it from its pack.
// A guide or contribution is public, or private to its owner. Lists return public documents only (a list query must
// ask for visibility == 'public'); the owner opens its private ones one by one.
service cloud.firestore {
  match /databases/{database}/documents {
    function at(collection, id) { return /databases/$(database)/documents/$(collection)/$(id); }
    function settings() { return get(at('settings', 'app')).data; }
    function admin() { return request.auth != null && request.auth.token.get('admin', false) == true; }
    // An account of an active community: its address domain is one the admins accepted, and the address is confirmed
    // when the settings require it. It signed in with its password, or with a token only the project's service account
    // can mint (the admin tools that act for an account, such as uploading material in its name).
    function student() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider in ['password', 'custom']
        && request.auth.token.get('email', '').lower().matches('[^@]+@[a-z0-9.-]+')
        && request.auth.token.email.lower().split('@')[1] in settings().domains
        && (settings().get('confirmEmail', false) != true || request.auth.token.email_verified == true);
    }
    function member() { return admin() || student(); }
    // The owner as stored before this request, and as it will be after it (a batch creates both together).
    function mine(id) { return get(at('owners', id)).data.uid == request.auth.uid; }
    function mineAfter(id) { return getAfter(at('owners', id)).data.uid == request.auth.uid; }
    // Ids created from the app are Firestore's random 20-character ids.
    function appId(id) { return id.matches('[A-Za-z0-9]{20}'); }

    function shown(id) { return resource == null || resource.data.get('visibility', 'public') == 'public' || admin() || mine(id); }
    // An admin hiding or showing something: only its visibility (and its time) change.
    function hiding() {
      return admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visibility', 'updated'])
        && visibility(request.resource.data) && request.resource.data.updated == request.time;
    }
    function visibility(d) { return d.visibility in ['public', 'private']; }

    function text(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function optional(data, key, max) { return !(key in data) || (data[key] is string && data[key].size() <= max); }
    function described(d) {
      return text(d.course, 80) && text(d.title, 120) && text(d.theme, 24) && visibility(d)
        && optional(d, 'code', 30) && optional(d, 'university', 60) && optional(d, 'term', 60) && optional(d, 'professor', 80)
        && d.updated == request.time;
    }

    // The AI that made a guide, as its author states it.
    function made(a) {
      return a is map && a.keys().hasOnly(['provider', 'model', 'effort']) && a.provider in ['anthropic', 'openai', 'gemini', 'other']
        && (!('model' in a) || (a.model is string && a.model.size() <= 80))
        && (!('effort' in a) || a.effort in ['', 'low', 'medium', 'high', 'xhigh']);
    }
    function entry(d) {
      return d.keys().hasOnly(['course', 'code', 'university', 'term', 'professor', 'title', 'date', 'topics', 'concepts',
          'anchors', 'theme', 'level', 'visibility', 'by', 'ai', 'updated'])
        && optional(d, 'by', 60) && (!('ai' in d) || made(d.ai))
        && d.keys().hasAll(['course', 'title', 'date', 'topics', 'concepts', 'anchors', 'theme', 'visibility', 'updated'])
        && described(d)
        && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && (!('level' in d) || d.level in ['basic', 'standard', 'advanced'])
        && d.topics is list && d.topics.size() <= 40
        && d.concepts is list && d.concepts.size() <= 200
        && d.anchors is list && d.anchors.size() == d.concepts.size();
    }
    function guide(d) {
      return d.keys().hasOnly(['title', 'html', 'encoding', 'size', 'visibility', 'updated'])
        && d.keys().hasAll(['title', 'html', 'encoding', 'size', 'visibility', 'updated'])
        && text(d.title, 220) && visibility(d) && d.html is bytes && d.html.size() <= 900000 && d.encoding == 'gzip' && d.size is int
        && d.updated == request.time;
    }
    // stage: the evaluation it belongs to. source: a registered collection it comes from (it gets the credit). print: the
    // fingerprint of the original file, so the same file is not added twice.
    function contribution(d) {
      return d.keys().hasOnly(['kind', 'course', 'code', 'university', 'term', 'professor', 'title', 'stage', 'theme', 'source',
          'print', 'concepts', 'questions', 'examples', 'body', 'encoding', 'visibility', 'updated'])
        && d.keys().hasAll(['kind', 'course', 'title', 'theme', 'concepts', 'questions', 'examples', 'body', 'encoding',
          'visibility', 'updated'])
        && d.kind in ['exam', 'homework', 'lab', 'slides', 'notes', 'summary', 'book', 'syllabus', 'contest', 'curriculum', 'other']
        && described(d)
        && optional(d, 'stage', 40)
        && (!('source' in d) || (d.source is string && d.source.matches('[a-z0-9][a-z0-9-]{2,60}') && exists(at('sources', d.source))))
        && (!('print' in d) || (d.print is string && d.print.matches('[0-9a-f]{16,40}')))
        && d.concepts is list && d.concepts.size() <= 300
        && d.questions is int && d.examples is int
        && d.body is bytes && d.body.size() <= 900000 && d.encoding == 'gzip';
    }

    // A guide's catalog entry and its HTML always share the same visibility.
    function sameAs(collection, id) { return getAfter(at(collection, id)).data.visibility == request.resource.data.visibility; }

    match /catalog/{id} {
      allow get: if member() && shown(id);
      allow list: if member() && (resource.data.visibility == 'public' || admin());
      allow create: if student() && appId(id) && entry(request.resource.data) && mineAfter(id) && sameAs('guides', id);
      allow update: if (student() && mine(id) && entry(request.resource.data) && sameAs('guides', id)) || (hiding() && sameAs('guides', id));
      allow delete: if ((student() && mine(id)) || admin()) && !existsAfter(at('guides', id));
    }

    // One guide at a time: listing every guide would download all of them.
    match /guides/{id} {
      allow get: if member() && shown(id);
      allow create: if student() && appId(id) && guide(request.resource.data) && mineAfter(id) && sameAs('catalog', id);
      allow update: if (student() && mine(id) && guide(request.resource.data) && sameAs('catalog', id)) || (hiding() && sameAs('catalog', id));
      allow delete: if ((student() && mine(id)) || admin()) && !existsAfter(at('catalog', id));
    }

    match /contributions/{id} {
      allow get: if member() && shown(id);
      allow list: if member() && (resource.data.visibility == 'public' || admin());
      allow create: if student() && appId(id) && contribution(request.resource.data) && mineAfter(id);
      allow update: if (student() && mine(id) && contribution(request.resource.data)) || hiding();
      allow delete: if (student() && mine(id)) || admin();
    }

    // An owner is recorded only together with the guide or contribution it creates, which must not exist yet.
    match /sources/{id} {
      allow read: if member();
    }

    // The person's own space.
    function profile(d) {
      return d.keys().hasOnly(['nickname', 'name', 'career', 'semester', 'mode', 'ambience', 'sound', 'theme', 'lang', 'avatar',
          'goals', 'progress', 'deadlines', 'tiles', 'notes', 'links', 'focus', 'bubbles', 'courses', 'interests', 'known', 'updated'])
        && optional(d, 'nickname', 40) && optional(d, 'name', 60) && optional(d, 'career', 80)
        && (!('lang' in d) || d.lang in ['es', 'en'])
        && (!('avatar' in d) || d.avatar in ['blue', 'red', 'teal', 'butter', 'sky', 'peach'])
        && (!('semester' in d) || (d.semester is int && d.semester >= 0 && d.semester <= 20))
        && (!('mode' in d) || d.mode in ['examenes', 'gusto', 'intensivo', 'metas'])
        && (!('ambience' in d) || d.ambience in ['jugueton', 'vivo', 'sereno', 'enfoque'])
        && (!('sound' in d) || d.sound is bool)
        && (!('bubbles' in d) || d.bubbles is bool)
        && (!('theme' in d) || d.theme in ['auto', 'light', 'dark'])
        && (!('goals' in d) || (d.goals is list && d.goals.size() <= 60))
        && (!('progress' in d) || (d.progress is map && d.progress.size() <= 300))
        // The home page: the person's own dates, which tiles it shows, a notepad, quick links and the focus timer.
        && (!('deadlines' in d) || (d.deadlines is list && d.deadlines.size() <= 60))
        && (!('tiles' in d) || (d.tiles is list && d.tiles.size() <= 16))
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 4000))
        && (!('links' in d) || (d.links is list && d.links.size() <= 12))
        && (!('focus' in d) || (d.focus is map && d.focus.keys().hasOnly(['study', 'rest'])
          && d.focus.study is int && d.focus.study >= 5 && d.focus.study <= 90
          && d.focus.rest is int && d.focus.rest >= 1 && d.focus.rest <= 30))
        // The map: the person's courses this term, their interests, and the concepts they marked as known.
        && (!('courses' in d) || (d.courses is list && d.courses.size() <= 40))
        && (!('interests' in d) || (d.interests is list && d.interests.size() <= 40))
        && (!('known' in d) || (d.known is list && d.known.size() <= 1500))
        && d.updated == request.time;
    }
    match /profiles/{uid} {
      allow get, delete: if member() && request.auth.uid == uid;
      allow create, update: if member() && request.auth.uid == uid && profile(request.resource.data);
    }

    // A list without repeated values, all of them from the allowed ones.
    function picked(value, allowed, max) {
      return value is list && value.size() > 0 && value.size() <= max && value.toSet().size() == value.size() && value.hasOnly(allowed);
    }

    function kudo(id, d) {
      return d.keys().hasOnly(['guide', 'kinds', 'updated']) && d.keys().hasAll(['guide', 'kinds', 'updated'])
        && d.guide is string && d.guide.matches('[A-Za-z0-9-]{3,100}') && id == d.guide + '__' + request.auth.uid
        && exists(at('catalog', d.guide))
        && picked(d.kinds, ['salvo', 'entendi', 'examen', 'gracias'], 4)
        && d.updated == request.time;
    }
    match /kudos/{id} {
      allow read: if member();
      allow create, update: if student() && kudo(id, request.resource.data);
      allow delete: if (student() && id == resource.data.guide + '__' + request.auth.uid) || admin();
    }

    // A professor's name or a course: text without digits, addresses or markup.
    function name(value, max) { return text(value, max) && value.size() >= 3 && !value.matches('.*[0-9@/<>{}].*'); }
    function tip(id, d) {
      return d.keys().hasOnly(['prof', 'professor', 'course', 'tags', 'updated']) && d.keys().hasAll(['prof', 'professor', 'tags', 'updated'])
        && d.prof is string && d.prof.matches('[a-z0-9-]{2,90}') && id == d.prof + '__' + request.auth.uid
        && name(d.professor, 80) && (!('course' in d) || name(d.course, 80))
        && picked(d.tags, ['explica-claro', 'ejemplos', 'practico', 'teorico', 'responde', 'tutorias',
          'examen-deberes', 'examen-clase', 'examenes-largos', 'procedimiento', 'formato', 'participacion', 'proyectos',
          'puntos-extra', 'recuperar', 'reclamos', 'material',
          'asistencia', 'puntual', 'sin-formulas', 'leer-antes', 'ritmo', 'exigente',
          'ideal-teoria', 'ideal-practica', 'ideal-autonomo', 'ideal-guiado'], 27)
        && d.updated == request.time;
    }
    match /tips/{id} {
      allow read: if member();
      allow create, update: if student() && tip(id, request.resource.data);
      allow delete: if (student() && id == resource.data.prof + '__' + request.auth.uid) || admin();
    }

    // The library: course documents anyone may share (syllabi, lab guides, assignments, the professor's own material),
    // as links to where they are shared. Studium stores no file.
    function shared(id, d) {
      return d.keys().hasOnly(['course', 'code', 'professor', 'term', 'kind', 'title', 'url', 'note', 'by', 'updated'])
        && d.keys().hasAll(['course', 'kind', 'title', 'url', 'updated'])
        && name(d.course, 80) && text(d.title, 140) && optional(d, 'code', 30) && optional(d, 'term', 60)
        && optional(d, 'note', 200) && optional(d, 'by', 60) && (!('professor' in d) || name(d.professor, 80))
        && d.kind in ['syllabus', 'reading', 'lab', 'assignment', 'slides', 'other']
        && d.url is string && d.url.size() <= 500
        && d.url.matches('https://(drive[.]google[.]com|docs[.]google[.]com|onedrive[.]live[.]com|1drv[.]ms|[a-z0-9-]+[.]sharepoint[.]com|(www[.])?dropbox[.]com)/[^ <>"]*')
        && d.updated == request.time;
    }
    match /library/{id} {
      allow read: if member();
      allow create: if student() && appId(id) && shared(id, request.resource.data) && mineAfter(id);
      allow update: if student() && mine(id) && shared(id, request.resource.data);
      allow delete: if (student() && mine(id)) || admin();
    }

    match /owners/{id} {
      allow read: if member() && resource.data.uid == request.auth.uid;
      allow create: if student() && appId(id)
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
        && ((existsAfter(at('guides', id)) && !exists(at('guides', id)))
          || (existsAfter(at('contributions', id)) && !exists(at('contributions', id)))
          || (existsAfter(at('library', id)) && !exists(at('library', id))));
      allow delete: if ((student() && resource.data.uid == request.auth.uid) || admin())
        && !existsAfter(at('guides', id)) && !existsAfter(at('contributions', id)) && !existsAfter(at('library', id));
    }

    // The app's settings, kept by the admins.
    function community(c) {
      return c is map && c.keys().hasOnly(['id', 'name', 'full', 'domains', 'active']) && c.keys().hasAll(['id', 'name', 'domains', 'active'])
        && c.id is string && c.id.matches('[a-z0-9-]{2,30}') && text(c.name, 40) && optional(c, 'full', 120)
        && c.domains is list && c.domains.size() <= 20 && c.active is bool;
    }
    function appSettings(d) {
      return d.keys().hasOnly(['communities', 'domains', 'confirmEmail', 'flags', 'providers', 'announcement', 'googleClientId', 'updated', 'by'])
        && d.keys().hasAll(['communities', 'domains', 'confirmEmail', 'updated', 'by'])
        && d.communities is list && d.communities.size() >= 1 && d.communities.size() <= 30
        && community(d.communities[0])
        && d.domains is list && d.domains.size() <= 100
        && d.confirmEmail is bool
        && (!('flags' in d) || (d.flags is map && d.flags.size() <= 30))
        && (!('providers' in d) || (d.providers is list && d.providers.hasOnly(['anthropic', 'openai', 'gemini'])))
        && (!('announcement' in d) || (d.announcement is map && d.announcement.keys().hasOnly(['on', 'text', 'level'])
          && d.announcement.on is bool && d.announcement.text is string && d.announcement.text.size() <= 280
          && d.announcement.level in ['info', 'good', 'warn']))
        && (!('googleClientId' in d) || (d.googleClientId is string && d.googleClientId.size() <= 120))
        && d.by == request.auth.token.email && d.updated == request.time;
    }
    match /settings/{id} {
      allow get: if request.auth != null;
      allow create, update: if admin() && id == 'app' && appSettings(request.resource.data);
    }
    match /audit/{id} {
      allow read: if admin();
      allow create: if admin() && request.resource.data.keys().hasOnly(['action', 'detail', 'by', 'at'])
        && text(request.resource.data.action, 60) && request.resource.data.detail is string && request.resource.data.detail.size() <= 2000
        && request.resource.data.by == request.auth.token.email && request.resource.data.at == request.time;
    }

    // When an account was last seen: written on real events (signing in, opening the page, coming back to it,
    // changing page), never on a timer. Admins count them; nobody sees another account's document.
    match /presence/{uid} {
      allow get: if member() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create, update: if member() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at', 'community', 'since'])
        && request.resource.data.at == request.time
        && request.resource.data.community is string && request.resource.data.community.size() <= 30
        && request.resource.data.since is timestamp;
    }

    // Packs: compiled by admins; every member reads them.
    function packIndex(d) {
      return d.keys().hasOnly(['build', 'parts', 'count', 'at', 'built', 'by']) && d.keys().hasAll(['build', 'parts', 'count', 'at', 'built', 'by'])
        && d.build is string && d.build.matches('[a-z0-9]{4,30}') && d.parts is int && d.parts >= 0 && d.parts <= 400
        && d.count is int && d.at is timestamp && d.built == request.time && d.by == request.auth.token.email;
    }
    function packPart(id, d) {
      return d.keys().hasOnly(['build', 'i', 'of', 'data']) && d.keys().hasAll(['build', 'i', 'of', 'data'])
        && d.build is string && d.i is int && d.of is int && id == d.build + '-' + string(d.i)
        && d.data is bytes && d.data.size() <= 900000;
    }
    match /packs/{id} {
      allow read: if member();
      allow create, update: if admin() && ((id == 'index' && packIndex(request.resource.data)) || (id != 'index' && packPart(id, request.resource.data)));
      allow delete: if admin() && id != 'index';
    }
    // A contribution that stopped being public: written by its owner in the same batch that deletes it or makes it
    // private (or by an admin), and read by every map.
    match /removed/{id} {
      allow read: if member();
      allow create, update: if (admin() || (student() && mine(id)))
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
    }

    // How many people found each easter egg: a counter that only goes up by one.
    match /eggs/{id} {
      allow read: if admin();
      allow create: if member() && id in ['radio', 'portal', 'cake', 'medic', 'crit']
        && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1;
      allow update: if member() && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == resource.data.count + 1;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
